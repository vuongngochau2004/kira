# ===================================
# K.I.R.A Environment Configuration Template
# Copy this file to .env and fill in values
# ===================================

# ----- Application & Network -----
APP_NAME=kira-simple
APP_ENV=development
DEBUG=true
BACKEND_PORT=8006
FRONTEND_PORT=3001
AUTH_ENABLED=true

# ----- Authentication Secrets (REQUIRED) -----
JWT_SECRET_KEY=your-jwt-secret-change-this

# ----- Infrastructure Services (Local Docker Compose) -----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=kira
POSTGRES_PASSWORD=kira_secret
POSTGRES_DB=kira_dev

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=kira_minio
MINIO_SECRET_KEY=kira_minio_secret
MINIO_BUCKET=kira-documents

# ----- Active LLM Provider -----
# Options: openai_compatible, glm, gemini, ollama
LLM_PROVIDER=openai_compatible

# OpenAI-compatible / Self-hosted LLM (Default)
BK_LLM_BASE_URL=https://your-llm-host/v1
BK_LLM_MODEL=your-model-name
BK_API_KEY=not-needed

# Fallback LLM Options (fill if using these providers)
GLM_API_KEY=your-glm-api-key
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEYS=your-ollama-api-key
OLLAMA_MODEL=gemma4:31b-cloud

# ----- Embedding Service -----
# Options: aivn, ollama, tei
EMBEDDING_PROVIDER=aivn
AIVN_EMBEDDING_BASE_URL=http://your-server-ip:8888

# ----- TEI Service (DUT AI Embeddings & Reranking) -----
TEI_BASE_URL=https://textembedding.dutai.io.vn
TEI_API_KEY=your-tei-api-key
TEI_EMBEDDING_MODEL=BAAI/bge-m3

RERANKING_ENABLED=false
RERANKING_MODE=tei
TEI_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ----- Optional External Services -----
OCR_ENABLED=false
OCR_BASE_URL=http://localhost:8889

# Legal knowledge graph (Neo4j)
LEGAL_ENABLED=false
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kira_neo4j_password
NEO4J_DATABASE=neo4j
