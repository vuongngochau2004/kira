# ===================================
# K.I.R.A Simplified Environment Variables
# Copy this file to .env and fill in values
# ===================================

# ----- Application -----
APP_NAME=kira-simple
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-this
API_HOST=0.0.0.0
# The only local service ports to change.
BACKEND_PORT=8006
FRONTEND_PORT=3001
# Timeout for each external service check emitted at backend startup.
SERVICE_HEALTH_TIMEOUT_SECONDS=5
# Celery broadcasts wait for this entire interval before returning responses.
CELERY_HEALTH_TIMEOUT_SECONDS=1

# ----- PostgreSQL -----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=kira
POSTGRES_PASSWORD=kira_secret
POSTGRES_DB=kira_dev

# ----- Qdrant (Vector DB) -----
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
# QDRANT_COLLECTION and QDRANT_VECTOR_DIM are in config/settings.yaml

# ----- Redis / Celery -----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_CONCURRENCY=2

# ----- MinIO (Object Storage) -----
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=kira_minio
MINIO_SECRET_KEY=kira_minio_secret
MINIO_BUCKET=kira-documents
MINIO_SECURE=false

# ----- JWT Auth -----
JWT_SECRET_KEY=your-jwt-secret-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- LLM Provider -----
LLM_PROVIDER=ollama

# Z.ai GLM (default for Vietnamese)
GLM_API_URL=https://api.z.ai/api/anthropic
GLM_API_KEY=your-glm-api-key
GLM_MODEL=glm-4.5

# BK Self-hosted LLM (OpenAI-compatible)
BK_LLM_BASE_URL=https://llm.example.com/v1
BK_LLM_MODEL=google/gemma-3-27b-it
BK_API_KEY=not-needed

# Google Gemini (backup)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (optional)
OPENAI_API_KEY=your-openai-api-key

# Ollama Cloud
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEYS=your-ollama-api-key
OLLAMA_MODEL=gemma4:31b-cloud

# ----- Embedding -----
# Change only this value to switch the active adapter: aivn or ollama.
EMBEDDING_PROVIDER=aivn

# AIVN / Vietnamese_Embedding_v2 (1024 dimensions)
AIVN_EMBEDDING_BASE_URL=http://your-linux-server-ip:8888
AIVN_EMBEDDING_MODEL=vietnamese-embedding-v2
AIVN_EMBEDDING_DIM=1024
AIVN_QDRANT_COLLECTION=document_chunks

# Ollama Cloud / embeddinggemma (768 dimensions)
OLLAMA_EMBEDDING_BASE_URL=https://ollama.com/api
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_EMBEDDING_DIM=768
OLLAMA_QDRANT_COLLECTION=document_chunks_ollama

# Retrieval & Chunking parameters are in config/settings.yaml

# ----- CORS -----
# Leave unset for local development: origins are derived from FRONTEND_PORT.
# Set this only to override CORS origins in a deployed environment.
# CORS_ORIGINS=https://app.example.com

# ----- Auth (development mode) -----
# Set to false to bypass JWT auth for local development (NEVER false in production!)
AUTH_ENABLED=true

# ----- OCR (PaddleOCR) -----
OCR_ENABLED=true
OCR_BASE_URL=
OCR_LANG=vi
OCR_TIMEOUT=30
OCR_MAX_RETRIES=3
OCR_BATCH_SIZE=5
PDF_EXTRACTOR=vlm
DOCLING_QUALITY_GATE_ENABLED=true
DOCLING_QUALITY_FALLBACK_SCORE=3
PDF_RENDER_DPI=300
VLM_IMAGE_MAX_SIDE=2200
VLM_IMAGE_JPEG_QUALITY=88
VLM_TRANSCRIPTION_TIMEOUT=120
VLM_TRANSCRIPTION_MAX_TOKENS=4096
VLM_PAGE_VERIFICATION_ENABLED=true
VLM_VERIFY_ONLY_FAILED_PAGES=true
VLM_PAGE_CONCURRENCY=2
VLM_MIN_PAGE_COVERAGE_RATIO=0.7
DOCUMENT_AUDIT_ENABLED=true
DOCUMENT_AUDIT_DIR=reports/document_processing
LEGAL_CANONICALIZATION_ENABLED=false
LEGAL_CANONICALIZATION_MAX_CHARS=60000
LEGAL_CHUNKING_ENABLED=true
